# Copy the project endpoint from the Microsoft Foundry project home page.
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# The deployment name is not an agent name or a catalog model ID.
AZURE_AI_MODEL_DEPLOYMENT_NAME=your-model-deployment

# These bounds keep this educational exercise small.
MAX_OUTPUT_TOKENS=1200
MAX_CHAT_TURNS=10

# For reasoning models such as gpt-5-mini. Leave empty for non-reasoning models.
REASONING_EFFORT=low
